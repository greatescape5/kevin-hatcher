# Copy this file to .env.local for local development.
# In Vercel, add these same keys under Settings → Environment Variables, then REDEPLOY.

# From Supabase → Settings → API
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Email notifications via Resend (leads still save to the DB without these).
# Get the API key at resend.com → API Keys.
RESEND_API_KEY=
# Where new-lead notifications are sent. Any inbox works — Kevin's Yahoo is fine:
LEAD_TO_EMAIL=Khatcher40@yahoo.com
# The "from" address. MUST be on a domain you've VERIFIED in Resend — you cannot
# send from @yahoo.com. e.g. leads@kevinhatcherexcavation.com
LEAD_FROM_EMAIL=leads@kevinhatcherexcavation.com
